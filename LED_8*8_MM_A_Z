void displayLetter(byte letter[8]) {
  for (int i = 0; i < 8; i++) {
    matrix.setRow(0, i, letter[i]);
  }
}

void setup() {
  matrix.shutdown(0, LOW);
  matrix.setIntensity(0, 8);
  matrix.clearDisplay(0);
}

void loop() {
  for (int i = 0; i < 26; i++) {
    displayLetter(lettersCapital[i]);  // Display A-Z
    delay(1000);
  }
}
