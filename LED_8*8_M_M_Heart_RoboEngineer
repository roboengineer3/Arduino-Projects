// Function to display each letter/shape
void displayLetter(byte letter[8]) {
  for (int i = 0; i < 8; i++) {
    matrix.setRow(0, i, letter[i]);
  }
}

void setup() {
  matrix.shutdown(0, LOW);
  matrix.setIntensity(0, 8);    // Set brightness (0-15)
  matrix.clearDisplay(0);       // Clear the display
}

