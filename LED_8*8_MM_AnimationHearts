#include "LedControl.h"  // Install this library

int DIN = 7;
int CS = 6;
int CLK = 5;

LedControl matrix = LedControl(DIN, CLK, CS, 1);

// Heart Shape 1 - Classic Heart
byte heart1[8] = { 
  0b00000000,  
  0b01100110,
  0b11111111,
  0b11111111,
  0b01111110,
  0b00111100,
  0b00011000,
  0b00000000
};

// Heart Shape 2 - Bigger Heart
byte heart2[8] = { 
  0b00000000,  
  0b00111100,
  0b01111110,
  0b11111111,
  0b11111111,
  0b01111110,
  0b00111100,
  0b00000000
};

// Heart Shape 3 - Wide Heart
byte heart3[8] = { 
  0b00000000,  
  0b01111110,
  0b11111111,
  0b11111111,
  0b11111111,
  0b01111110,
  0b00111100,
  0b00011000
};

// Function to animate heart appearing smoothly
void animateHeart(byte heart[8], int speed) {
  for (int i = 0; i < 8; i++) {  
    matrix.setRow(0, i, heart[i]); 
    delay(speed);  // Faster speed
  }
}

void clearMatrix() {
  matrix.clearDisplay(0);
  delay(500);
}

void setup() {
  matrix.shutdown(0, LOW);
  matrix.setIntensity(0, 10);  // Brightness level 10
  matrix.clearDisplay(0);
}

void loop() {
  animateHeart(heart1, 100);  // Show first heart quickly
  delay(1000);
  clearMatrix();  

  animateHeart(heart2, 100);  // Show second heart quickly
  delay(1000);
  clearMatrix();  

  animateHeart(heart3, 100);  // Show third heart quickly
  delay(1000);
  clearMatrix();  
}
