#include "LedControl.h"  // Install this library

int DIN = 7;
int CS =  6;
int CLK = 5;

LedControl matrix = LedControl(DIN, CLK, CS, 1);

// Heart Shape Pattern
byte heart[8] = {
  0b00000000,  
  0b01100110,  
  0b11111111,  
  0b11111111,  
  0b01111110,  
  0b00111100,  
  0b00011000,  
  0b00000000  
};

void setup() {
  matrix.shutdown(0, LOW);
  matrix.setIntensity(0, 8);    // Set brightness (0-15)
  matrix.clearDisplay(0);       // Clear the display
}

void loop() {
  // Display Heart Shape
  for (int i = 0; i < 8; i++) {
    matrix.setRow(0, i, heart[i]);
  }
  delay(5000); // Display heart for 5 seconds

  // Clear display (turn off all LEDs)
  matrix.clearDisplay(0);
  delay(2000); // Keep LEDs off for 2 seconds
}
