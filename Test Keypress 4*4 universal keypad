#include <Keypad.h>

// Define the number of rows and columns
const byte ROWS = 4;
const byte COLS = 4;

// Keypad layout
char keys[ROWS][COLS] = {
  {'1', '2', '3', 'A'},
  {'4', '5', '6', 'B'},
  {'7', '8', '9', 'C'},
  {'*', '0', '#', 'D'}
};

// Define row and column pins connected to Arduino Mega
byte rowPins[ROWS] = {22, 23, 24, 25};  // R1, R2, R3, R4
byte colPins[COLS] = {26, 27, 28, 29};  // C1, C2, C3, C4

// Create Keypad object
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

void setup() {
  Serial.begin(9600);
}

void loop() {
  char key = keypad.getKey();  // Check if a key is pressed

  if (key) {  // If a key is pressed
    Serial.print("Key Pressed: ");
    Serial.println(key);  // Print the key value
  }
}
