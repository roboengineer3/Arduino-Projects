
#include "LedControl.h"  // Install this library

int DIN = 7;
int CS = 6;
int CLK = 5;

LedControl matrix = LedControl(DIN, CLK, CS, 1);

byte heart[8] = { 
  0b00000000,  
  0b01100110,
  0b11111111,
  0b11111111,
  0b01111110,
  0b00111100,
  0b00011000,
  0b00000000
};

// Function to animate heart appearing one LED at a time
void animateHeartOn() {
  byte temp[8] = {0}; // Empty matrix
  for (int i = 0; i < 8; i++) {  
    for (int j = 0; j < 8; j++) {  
      if (heart[i] & (1 << j)) {  // Check if LED should be on
        temp[i] |= (1 << j);  // Turn on LED one by one
        matrix.setRow(0, i, temp[i]); 
        delay(100);  
      }
    }
  }
}

// Function to animate heart disappearing one LED at a time
void animateHeartOff() {
  byte temp[8];
  memcpy(temp, heart, 8);  // Copy heart to temp array
  for (int i = 7; i >= 0; i--) {  
    for (int j = 7; j >= 0; j--) {  
      if (heart[i] & (1 << j)) {  
        temp[i] &= ~(1 << j);  // Turn off LED one by one
        matrix.setRow(0, i, temp[i]);
        delay(100);
      }
    }
  }
}

void setup() {
  matrix.shutdown(0, LOW);
  matrix.setIntensity(0, 8);
  matrix.clearDisplay(0);
}

void loop() {
  animateHeartOn();   // Show heart LED by LED
  delay(1000);        // Wait before turning it off
  animateHeartOff();  // Hide heart LED by LED
  delay(1000);
}
