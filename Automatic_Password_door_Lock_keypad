#include <EEPROM.h>
#include <Servo.h>
#include <LiquidCrystal_I2C.h>
#include <Keypad.h>

#define BUZZER 11
#define SERVO_PIN 10

Servo lockServo;
LiquidCrystal_I2C lcd(0x27, 16, 2);

const byte ROWS = 4;
const byte COLS = 4;
char keys[ROWS][COLS] = {
  {'D', 'A', 'B', 'C'},
  {'#', '3', '6', '9'},
  {'0', '2', '5', '8'},
  {'*', '1', '4', '7'}
};
byte rowPins[ROWS] = {2, 3, 4, 5};
byte colPins[COLS] = {6, 7, 8, 9};
Keypad keypad = Keypad(makeKeymap(keys), rowPins, colPins, ROWS, COLS);

String enteredPassword = "";
String storedPassword = "1234"; // Default password (will be updated from EEPROM)

void setup() {
  Serial.begin(9600);
  lcd.init();
  lcd.backlight();
  pinMode(BUZZER, OUTPUT);
  lockServo.attach(SERVO_PIN);
  lockServo.write(0); // Locked position
  
  // Read stored password from EEPROM
  loadPassword();
  
  lcd.setCursor(3, 0);
  lcd.print("WELCOME TO");
  lcd.setCursor(0, 1);
  lcd.print("DOOR LOCK SYSTEM");
  delay(3000);
  lcd.clear();
}

void loop() {
  lcd.setCursor(1, 0);
  lcd.print("ENTER PASSWORD:");
  lcd.setCursor(5, 1);
  lcd.print(enteredPassword);

  char key = keypad.getKey();
  if (key) {
    if (key == '*') {  // Reset entry
      enteredPassword = "";
      lcd.clear();
    } else if (key == '#') {  // Submit password
      checkPassword();
    } else if (key == 'A') {  // Change password mode
      changePassword();
    } else {
      if (enteredPassword.length() < 6) {
        enteredPassword += key;
      }
    }
  }
}

void checkPassword() {
  lcd.clear();
  if (enteredPassword == storedPassword) {
    lcd.setCursor(0, 0);
    lcd.print("ACCESS GRANTED");
    digitalWrite(BUZZER, HIGH);
    delay(300);
    digitalWrite(BUZZER, LOW);
    lockServo.write(90); // Unlock
    delay(5000); // Keep open for 5 sec
    lockServo.write(0); // Lock again
  } else {
    lcd.setCursor(0, 0);
    lcd.print("WRONG PASSWORD!");
    digitalWrite(BUZZER, HIGH);
    delay(200);
    digitalWrite(BUZZER, LOW);
    delay(200);
    digitalWrite(BUZZER, HIGH);
    delay(200);
    digitalWrite(BUZZER, LOW);
  }
  delay(2000);
  enteredPassword = "";
  lcd.clear();
}

void changePassword() {
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("NEW PASSWORD:");
  String newPass = "";
  
  while (newPass.length() < 6) {
    char key = keypad.getKey();
    if (key) {
      if (key == '#') break;
      newPass += key;
      lcd.setCursor(5, 1);
      lcd.print(newPass);
    }
  }
  
  storedPassword = newPass;
  savePassword();
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("PASSWORD SAVED!");
  delay(2000);
  lcd.clear();
}

void savePassword() {
  for (int i = 0; i < 6; i++) {
    EEPROM.write(i, storedPassword[i]);
  }
}

void loadPassword() {
  storedPassword = "";
  for (int i = 0; i < 6; i++) {
    char c = EEPROM.read(i);
    if (c != 0xFF) {  // EEPROM default value check
      storedPassword += c;
    }
  }
}

