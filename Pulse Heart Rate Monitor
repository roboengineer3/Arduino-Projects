#include <LiquidCrystal.h>

// LCD pin connections: rs, en, d4, d5, d6, d7
const int rs = 12, en = 11, d4 = 5, d5 = 4, d6 = 3, d7 = 2;
LiquidCrystal lcd(rs, en, d4, d5, d6, d7);

const int pulsePin = A0;  // Pulse sensor connected to A0
int pulseValue = 0;       // Variable to store pulse sensor reading
int bpm = 0;              // Variable to store calculated beats per minute

void setup() {
    Serial.begin(9600);   // Start serial communication
    lcd.begin(16, 2);     // Initialize 16×2 LCD

    // Display startup message
    lcd.setCursor(0, 0);
    lcd.print("Welcome RMVM");
    delay(2000);
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Heart Rate Monitor ");
    lcd.setCursor(0, 1);
    lcd.print(" Initializing...  ");
    delay(2000);
    lcd.clear();
}

void loop() {
    pulseValue = analogRead(pulsePin);  // Read pulse sensor value
    bpm = map(pulseValue, 500, 1023, 60, 120);  // Map value to BPM (Adjust as needed)

    // Display on LCD
    lcd.setCursor(0, 0);
    lcd.print("Pulse: "); 
    lcd.print(pulseValue); // Raw sensor value
    
    lcd.setCursor(0, 1);
    lcd.print("BPM: "); 
    lcd.print(bpm);  // Calculated heart rate
    lcd.print("    ");

    // Print to Serial Monitor for debugging
    Serial.print("Pulse Value: ");
    Serial.print(pulseValue);
    Serial.print("\t BPM: ");
    Serial.println(bpm);

    delay(500);  // Refresh rate
}
